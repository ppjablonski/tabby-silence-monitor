{
  "name": "tabby-silence-monitor",
  "version": "0.2.0",
  "description": "Desktop notifications for terminal output inactivity, with per-pane monitoring and click-to-focus in Tabby.",
  "license": "MIT",
  "keywords": [
    "tabby-plugin",
    "tabby",
    "terminal",
    "inactivity",
    "notifications",
    "ssh",
    "wsl"
  ],
  "main": "dist/index.js",
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "test": "npm run build && tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && webpack --mode production",
    "package": "npm run build && python3 scripts/package.py"
  },
  "devDependencies": {
    "@angular/common": "15.2.10",
    "@angular/core": "15.2.10",
    "@angular/forms": "15.2.10",
    "@types/node": "18.19.130",
    "rxjs": "7.8.2",
    "tabby-core": "1.0.231-nightly.0",
    "tabby-settings": "1.0.231-nightly.0",
    "tabby-terminal": "1.0.231-nightly.0",
    "ts-loader": "9.5.4",
    "tsx": "4.20.6",
    "typescript": "4.9.5",
    "webpack": "5.112.2",
    "webpack-cli": "5.1.4"
  },
  "author": "tabby-silence-monitor contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ppjablonski/tabby-silence-monitor.git"
  },
  "homepage": "https://github.com/ppjablonski/tabby-silence-monitor#readme",
  "bugs": {
    "url": "https://github.com/ppjablonski/tabby-silence-monitor/issues"
  }
}
