{
  "name": "tabby-silence-monitor",
  "version": "0.2.0",
  "description": "Per-session terminal output inactivity notifications for Tabby 1.0.238",
  "license": "MIT",
  "keywords": [
    "tabby-plugin"
  ],
  "main": "dist/index.js",
  "files": [
    "dist/index.js",
    "README.md",
    "PLAN.md",
    "WINDOWS-TESTS.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run build && tsx --test test/*.test.ts",
